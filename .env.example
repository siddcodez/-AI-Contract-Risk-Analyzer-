# ============================================================
# AI Contract Risk Analyzer — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application -----------------------------------------------
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ---- PostgreSQL ------------------------------------------------
# Runtime app connection — uses the non-superuser app_user role.
# This role has NOSUPERUSER and NOBYPASSRLS so RLS policies are enforced.
DATABASE_URL=postgresql+asyncpg://app_user:app_pass@localhost:5432/contract_risk_db

# Migration connection — uses contract_user with elevated privileges.
# Used only by Alembic for schema changes.  Never used at runtime.
MIGRATION_DATABASE_URL=postgresql+asyncpg://contract_user:contract_pass@localhost:5432/contract_risk_db

# ---- Redis -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / S3-compatible object storage ----------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=contract-documents
# Set to True only when connecting to real AWS S3 (not MinIO)
MINIO_USE_SSL=False

# ---- Celery ----------------------------------------------------
# Reuses REDIS_URL; override here only if using a different Redis DB
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Security --------------------------------------------------
# Algorithm for JWT signing — HS256 is fine for a single-service setup
JWT_ALGORITHM=HS256
# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- (Future — LLM, added at M4) --------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
