# ============================================================
# AI Contract Risk Analyzer — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application -----------------------------------------------
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ---- PostgreSQL ------------------------------------------------
# Runtime app connection — uses the non-superuser app_user role.
# This role has NOSUPERUSER and NOBYPASSRLS so RLS policies are enforced.
DATABASE_URL=postgresql+asyncpg://app_user:app_pass@localhost:5432/contract_risk_db

# Migration connection — uses contract_user with elevated privileges.
# Used only by Alembic for schema changes. Never used at runtime.
MIGRATION_DATABASE_URL=postgresql+asyncpg://contract_user:contract_pass@localhost:5432/contract_risk_db

# ---- Redis -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / S3-compatible object storage ----------------------
# For local dev with MinIO: set MINIO_ENDPOINT=http://localhost:9000
# For native AWS S3 in production: leave MINIO_ENDPOINT empty / unset
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=contract-documents
MINIO_USE_SSL=False
AWS_REGION=us-east-1

# ---- Celery ----------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Security & JWT --------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Rate Limiting ---------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_ANALYSIS=10/minute
RATE_LIMIT_ASK=15/minute

# ---- LLM Configuration (Grounded Q&A & Risk Analysis) ---------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional fallback provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Notifications (Optional) ----------------------------------
NOTIFICATION_EMAIL_ENABLED=False
NOTIFICATION_SLACK_ENABLED=False
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
